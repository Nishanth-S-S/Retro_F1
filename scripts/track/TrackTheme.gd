class_name TrackTheme
extends RefCounted
## What each circuit's surroundings look like: ground colours, vegetation, buildings,
## water and landmarks. Track.gd turns this into scenery; nothing here touches the racing.

## Each circuit's surroundings now come from its own data file (data/tracks/<id>.json,
## "theme", generated by tools/atlas_import.py from the atlas environment brief, with hand
## edits in data/tracks/overrides/<id>.json). TrackScenery turns it into the 2D surroundings.
const FALLBACK := {
	"label": "PARKLAND", "rain": 0.18,
	"ground": "3f7a3a", "stripe": "47863f", "patch": "376f34", "gravel": "c9b58a",
	"trees": ["round", "round", "hedge"], "tree_count": 900, "tree_a": "24582a", "tree_b": "357a38",
	"buildings": "villa", "building_count": 30, "rocks": 0, "landmark": "", "water": "",
}
## The test track keeps a plain theme of its own.
const TEST_TRACKS := {"apex_lab": {"label": "TEST TRACK", "rain": 0.0, "ground": "5a8a44", "stripe": "62934a", "patch": "527f3f", "gravel": "cfc39c",
	"trees": ["shrub"], "tree_count": 60, "tree_a": "3f6b34", "tree_b": "5a8a44", "buildings": "hangar", "building_count": 4, "rocks": 0, "landmark": "airfield", "water": ""}}

static var _cache := {}


## The full track data file (with overrides merged) - cached.
static func track_data(track_id: String) -> Dictionary:
	if not _cache.has(track_id):
		var data: Variant = SaveManager.load_json("res://data/tracks/%s.json" % track_id)
		var merged: Dictionary = data if data is Dictionary else {}
		var override_path := "res://data/tracks/overrides/%s.json" % track_id
		var override: Variant = SaveManager.load_json(override_path) if FileAccess.file_exists(override_path) else null
		if override is Dictionary:
			merged = TrackTheme.merge(merged, override)
		_cache[track_id] = merged
	return _cache[track_id]


## Deep merge: dictionaries merge key by key, everything else is replaced.
static func merge(base: Dictionary, over: Dictionary) -> Dictionary:
	var out := base.duplicate(true)
	for key: String in over:
		if out.has(key) and out[key] is Dictionary and over[key] is Dictionary:
			out[key] = TrackTheme.merge(out[key], over[key])
		else:
			out[key] = over[key]
	return out


static func of(track_id: String) -> Dictionary:
	if TEST_TRACKS.has(track_id):
		return TEST_TRACKS[track_id]
	var theme: Dictionary = track_data(track_id).get("theme", {})
	var out := FALLBACK.duplicate(true)
	for key: String in theme:
		out[key] = theme[key]
	return out


## Track-specific landmarks (e.g. "old_banking", "harbour_yachts:sea", "ferris_wheel").
static func landmarks(track_id: String) -> Array:
	return track_data(track_id).get("landmarks", [])


static func family(track_id: String) -> String:
	return str(track_data(track_id).get("family", "parkland"))


static func label(track_id: String) -> String:
	return str(of(track_id)["label"])


static func rain_chance(track_id: String) -> float:
	return float(of(track_id)["rain"])
